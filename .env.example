# Environment Config

#the twitch channel login for the bot to watch; chat is read from and sent to the TWITCH_CHANNEL_ID channel,
#so this must name the same channel as TWITCH_CHANNEL_ID
twitch_channel=
#the bot account's login; only compared with chatters' display names so the bot's own messages skip crowd sounds.
#keep it set. Who the bot chats as comes from TWITCH_BOT_ID
bot_account=
#banner image to show on the queue list page
banner_image=
#the url to send for the !list command
queue_list_url=
OPENAI_API_KEY=
youtube_list_url=
ratings_list_url=
#auth for the web interface
web_user=
web_pass=
# Shared secret that authorizes mutating Socket.IO events (board/timer/donation
# admin actions). REQUIRED: if unset, all admin socket actions are blocked.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Programmatic clients (e.g. external donation integrations) must send it as
# socket.handshake.auth.token; browser admin pages get it automatically via cookie.
admin_socket_token=
# Legacy bot credentials, not read by the app
twitch_client_id=
twitch_client_secret=
streamlabs_access_token=
streamlabs_socket_token=
# EventSub app credentials (create new app at https://dev.twitch.tv/console)
EVENTSUB_CLIENT_ID=
EVENTSUB_CLIENT_SECRET=

# Channel IDs (numeric IDs, not usernames)
TWITCH_CHANNEL_ID=      # Production channel; chat is read from and sent to this channel (twitch_channel must match)
TEST_CHANNEL_ID=        # For testing

# Numeric Twitch user id of the bot account (abbadabbabot is 772229635, used when unset).
# The bot authorizes the app once from /auth and no bot token is stored.
TWITCH_BOT_ID=

youtube_api_key=

# Twitch OAuth Redirect URI; must be registered in the Twitch app.
# Unset means https://leantube.org/auth/twitch/callback. Set it on staging.
TWITCH_REDIRECT_URI=

CLAP_THRESHOLD=1
LOL_THRESHOLD=1
FART_THRESHOLD=1
MOAN_THRESHOLD=1
BOO_THRESHOLD=1

# Web Push (turn notifications on contestant pages).
# Generate a keypair with: npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URL identifying you to push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@leantube.org
