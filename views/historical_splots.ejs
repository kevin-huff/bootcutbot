<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/site-head', {
    title: 'Bootcut — The Splot Database',
    description: 'The bootcut historical splot database is a place to find all splots previously used on bootcut'
  }) %>
</head>
<body class="os-body">
  <%- include('partials/site-nav', { active: 'splots' }) %>
  <main class="os-main">
    <%
      const entries = Object.entries(splots).map(function ([splot, date]) {
        const d = String(date).slice(0, 10);
        return { splot, date: d, ts: Date.parse(d) || 0 };
      });
      entries.sort(function (a, b) { return b.ts - a.ts; });
      const now = new Date();
      const monthStart = new Date(now.getFullYear(), now.getMonth(), 1).getTime();
      const newThisMonth = entries.filter(function (e) { return e.ts >= monthStart; }).length;
    %>

    <div class="os-pagehead">
      <div class="lead">
        <span class="os-kicker"><span class="star">✦</span>The Archive<span class="star">✦</span></span>
        <h1>The Splot Database</h1>
        <p class="blurb">
          Every dare pulled on Bootcut since June 2022, preserved for the historical record.
          On your turn, invoke <code>!auto_splot</code> and fate will choose one of these for you.
        </p>
      </div>
      <div class="aside">
        <div class="os-stat big">
          <span class="label">Total Splots</span>
          <span class="os-tote"><%= entries.length %></span>
        </div>
        <div class="os-stat big">
          <span class="label">New This Month</span>
          <span class="os-tote jade"><%= newThisMonth %></span>
        </div>
      </div>
    </div>

    <div class="os-toolbar">
      <label class="os-search">
        <span class="ico">⌕</span>
        <input type="search" data-ledger-search="splots" placeholder="Search the archive… (try 'mustard')">
      </label>
      <button class="os-chip" type="button" data-ledger-sort="splots" data-key="date" data-dir="desc" data-type="num">Newest</button>
      <button class="os-chip" type="button" data-ledger-sort="splots" data-key="alpha" data-dir="asc" data-type="str">A–Z</button>
    </div>

    <div class="os-content">
      <div class="os-ledger" data-ledger="splots" data-page-size="25" style="--cols: 60px 1fr 160px;">
        <div class="os-lhead">
          <span>№</span><span>Splot</span><span class="os-right">First Played</span>
        </div>
        <% entries.forEach(function (e, i) { %>
        <div class="os-lrow"
             data-search="<%= e.splot.toLowerCase() %>"
             data-date="<%= e.ts %>"
             data-alpha="<%= e.splot.toLowerCase() %>">
          <span class="num"><%= String(entries.length - i).padStart(3, '0') %></span>
          <span class="entry"><%= e.splot %></span>
          <span class="mono os-right"><%= e.date %></span>
        </div>
        <% }); %>
      </div>
    </div>

    <div class="os-pages" data-ledger-pages="splots"></div>

  </main>
  <%- include('partials/site-footer') %>
</body>
</html>
