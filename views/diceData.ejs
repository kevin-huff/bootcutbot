<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/site-head', {
    title: 'Bootcut — Dice Roll Analysis',
    description: "With our advanced roll tracking technology we can provide realtime dice stats for every roll of the dice in Abbabox's interactive boardgame of Bootcut"
  }) %>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/lodash@4.17.21/lodash.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/moment@2.29.1/moment.min.js"></script>
</head>
<body class="os-body">
  <%- include('partials/site-nav', { active: 'dice' }) %>
  <main class="os-main">

    <div class="os-pagehead">
      <div class="lead">
        <span class="os-kicker"><span class="star">✦</span>Advanced Roll Tracking Technology<span class="star">✦</span></span>
        <h1>Dice Roll Analysis</h1>
        <p class="blurb">
          Every roll of every die, inscribed automatically as the game unfolds. Suspect
          the dice are buttered? Invoke <code>!log_roll</code> and help build the case.
        </p>
      </div>
      <div class="os-select">
        <label for="sessionSelect">Session</label>
        <select id="sessionSelect"></select>
      </div>
    </div>

    <div class="os-grid-8">
      <div class="os-stat"><span class="label">Turns</span><span class="os-tote md" id="turns">—</span></div>
      <div class="os-stat"><span class="label">Total Rolls</span><span class="os-tote md" id="totalRolls">—</span></div>
      <div class="os-stat"><span class="label">Breakaway D6</span><span class="os-tote md" id="d6Rolls">—</span></div>
      <div class="os-stat"><span class="label">Board Rolls</span><span class="os-tote md" id="d12Rolls">—</span></div>
      <div class="os-stat"><span class="label">Successful BAs</span><span class="os-tote md jade" id="successfulBAs">—</span></div>
      <div class="os-stat"><span class="label">Hostage Rolls</span><span class="os-tote md crimson" id="hostageRolls">—</span></div>
      <div class="os-stat"><span class="label">Best Splot</span><span class="os-tote md jade" id="bestSplotNum">—</span></div>
      <div class="os-stat"><span class="label">Worst Splot</span><span class="os-tote md crimson" id="worstSplotNum">—</span></div>
    </div>

    <div class="os-grid-charts">
      <div class="os-chart" id="baDiceChart">
        <div class="chead">
          <span class="os-led xs is-blink"></span>
          <span class="os-kicker" style="font-size: 9.5px;">Breakaway Dice · D6 Distribution</span>
        </div>
        <div class="bars"></div>
      </div>
      <div class="os-chart crimson" id="boardDiceChart">
        <div class="chead">
          <span class="os-led xs is-blink" style="--c: var(--crimson-bright)"></span>
          <span class="os-kicker" style="font-size: 9.5px;" id="boardChartTitle">Board Dice · Distribution</span>
        </div>
        <div class="bars"></div>
      </div>
    </div>

    <div class="os-content" style="padding-bottom: 8px;">
      <div class="os-section-bar"><span class="t">Butter Watch · The Roll Ledger</span></div>
      <div class="os-ledger" id="rollLedger" style="--cols: 110px 170px 90px 1fr;">
        <div class="os-lhead">
          <span>Time</span><span>Die</span><span>Result</span><span>Dice Name</span>
        </div>
      </div>
    </div>

  </main>
  <%- include('partials/site-footer') %>

  <script>
    let sessions = [];
    let currentSessionIndex = 0;

    const BOARD_TYPES = ['D12', 'D8']; // board die was a d12, is now a d8

    async function getDiceRollData() {
      const response = await axios.get('/dice_log.json');
      return response.data.dice_roll;
    }

    function groupRollsBySession(rolls) {
      const sortedRolls = _.orderBy(rolls, roll => moment(roll.timestamp, 'MM/DD/YYYY, h:mm:ss A'), 'asc');
      let currentSession = [];
      for (let i = 0; i < sortedRolls.length; i++) {
        if (i === 0 || moment(sortedRolls[i].timestamp, 'MM/DD/YYYY, h:mm:ss A').diff(moment(sortedRolls[i - 1].timestamp, 'MM/DD/YYYY, h:mm:ss A'), 'hours') < 12) {
          currentSession.push(sortedRolls[i]);
        } else {
          sessions.push(currentSession);
          currentSession = [sortedRolls[i]];
        }
      }
      if (currentSession.length > 0) {
        sessions.push(currentSession);
      }
      sessions = _.reverse(sessions);
      updateSessionSelect();
    }

    function analyzeSession(session) {
      let totalRolls = 0;
      let d6Rolls = 0;
      let boardRolls = 0;
      let successfulBAs = 0;
      let hostageRolls = 0;
      let splotNumCounts = {};
      let baNumCounts = {};
      let boardFaces = 0;
      let lastRollTimestamp = null;
      let turns = 0;

      session.forEach(roll => {
        totalRolls++;
        if (roll.dice_type === 'D6') {
          d6Rolls++;
          baNumCounts[roll.roll_value] = (baNumCounts[roll.roll_value] || 0) + 1;
          if (roll.roll_value == 1 || roll.roll_value == 6) successfulBAs++;
          if (roll.roll_value == 3) hostageRolls++;
        }
        if (BOARD_TYPES.includes(roll.dice_type)) {
          boardRolls++;
          splotNumCounts[roll.roll_value] = (splotNumCounts[roll.roll_value] || 0) + 1;
          boardFaces = Math.max(boardFaces, roll.dice_type === 'D12' ? 12 : 8);
        }
      });

      const sortedSession = _.sortBy(session, 'timestamp');
      sortedSession.forEach(roll => {
        if (BOARD_TYPES.includes(roll.dice_type)) {
          const currentRollTimestamp = new Date(roll.timestamp);
          if (lastRollTimestamp !== null) {
            const diffMinutes = (currentRollTimestamp - lastRollTimestamp) / 1000 / 60;
            if (diffMinutes >= 2) turns++;
          } else {
            turns++;
          }
          lastRollTimestamp = currentRollTimestamp;
        }
      });

      const worstSplotNum = _.minBy(Object.keys(splotNumCounts), num => splotNumCounts[num]);
      const bestSplotNum = _.maxBy(Object.keys(splotNumCounts), num => splotNumCounts[num]);

      updateStats(turns, totalRolls, d6Rolls, boardRolls, successfulBAs, hostageRolls, worstSplotNum, bestSplotNum);
      renderBars('baDiceChart', baNumCounts, 6);
      renderBars('boardDiceChart', splotNumCounts, boardFaces || 8);
      document.getElementById('boardChartTitle').textContent =
        'Board Dice · D' + (boardFaces || 8) + ' Distribution';
      renderRollLedger(sortedSession);
    }

    function setStat(id, value) {
      document.getElementById(id).textContent = (value === undefined || value === null) ? '—' : value;
    }

    function updateStats(turns, totalRolls, d6Rolls, boardRolls, successfulBAs, hostageRolls, worstSplotNum, bestSplotNum) {
      setStat('turns', turns);
      setStat('totalRolls', totalRolls);
      setStat('d6Rolls', d6Rolls);
      setStat('d12Rolls', boardRolls);
      setStat('successfulBAs', successfulBAs);
      setStat('hostageRolls', hostageRolls);
      setStat('worstSplotNum', worstSplotNum ? '№' + worstSplotNum : '—');
      setStat('bestSplotNum', bestSplotNum ? '№' + bestSplotNum : '—');
    }

    function renderBars(chartId, counts, faces) {
      const bars = document.querySelector('#' + chartId + ' .bars');
      bars.innerHTML = '';
      const values = [];
      for (let f = 1; f <= faces; f++) values.push(counts[f] || 0);
      const max = Math.max(1, ...values);
      values.forEach((v, i) => {
        const col = document.createElement('div');
        col.className = 'barcol';
        const val = document.createElement('span');
        val.className = 'v';
        val.textContent = v;
        const bar = document.createElement('div');
        bar.className = 'bar';
        bar.style.height = ((v / max) * 100) + '%';
        const face = document.createElement('span');
        face.className = 'f';
        face.textContent = i + 1;
        col.appendChild(val);
        col.appendChild(bar);
        col.appendChild(face);
        bars.appendChild(col);
      });
    }

    function renderRollLedger(sortedSession) {
      const ledger = document.getElementById('rollLedger');
      ledger.querySelectorAll('.os-lrow').forEach(r => r.remove());
      const recent = sortedSession.slice(-14).reverse();
      recent.forEach(roll => {
        const isBoard = BOARD_TYPES.includes(roll.dice_type);
        const row = document.createElement('div');
        row.className = 'os-lrow';
        const time = new Date(roll.timestamp);
        const timeLabel = isNaN(time) ? roll.timestamp : time.toLocaleTimeString();

        const t = document.createElement('span');
        t.className = 'mono';
        t.textContent = timeLabel;

        const die = document.createElement('span');
        die.className = 'mono';
        die.style.color = isBoard ? 'var(--crimson-bright)' : 'var(--gilt)';
        die.textContent = roll.dice_type + ' · ' + (isBoard ? 'BOARD' : 'BREAKAWAY');

        const result = document.createElement('span');
        result.className = 'os-tote sm' + (isBoard ? ' crimson' : '');
        result.textContent = roll.roll_value;

        const name = document.createElement('span');
        name.className = 'entry';
        name.textContent = roll.dice_name || '—';

        row.appendChild(t);
        row.appendChild(die);
        row.appendChild(result);
        row.appendChild(name);
        ledger.appendChild(row);
      });
    }

    function updateSessionSelect() {
      const selectElement = document.getElementById('sessionSelect');
      selectElement.innerHTML = '';
      sessions.forEach((session, index) => {
        const optionElement = document.createElement('option');
        optionElement.value = index;
        optionElement.textContent = new Date(session[0].timestamp).toLocaleDateString();
        selectElement.appendChild(optionElement);
      });
    }

    document.getElementById('sessionSelect').addEventListener('change', function (e) {
      currentSessionIndex = e.target.value;
      analyzeSession(sessions[currentSessionIndex]);
    });

    (async function () {
      const rolls = await getDiceRollData();
      groupRollsBySession(rolls);
      if (sessions.length) analyzeSession(sessions[currentSessionIndex]);
    })();
  </script>
</body>
</html>
