<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/site-head', {
    title: 'Bootcut — The Ratings DB',
    description: "Abbabox's Recorded Ratings Round Up, where you can find the rating of anything that Abbabox has reviewed on twitch"
  }) %>
</head>
<body class="os-body">
  <%- include('partials/site-nav', { active: 'ratings' }) %>
  <main class="os-main">
    <%
      const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
        'July', 'August', 'September', 'October', 'November', 'December'];
      const items = (ratings || []).map(function (r) {
        const ts = r.timestamp || 0;
        const d = new Date(ts * 1000);
        return {
          item: r.item,
          rating: Number(r.rating) || 0,
          ts,
          dateLabel: ts ? monthNames[d.getMonth()] + ' ' + d.getDate() + ', ' + d.getFullYear() : '—'
        };
      });
      items.sort(function (a, b) { return b.ts - a.ts; });
      const avg = items.length
        ? (items.reduce(function (s, r) { return s + r.rating; }, 0) / items.length).toFixed(1)
        : '0.0';
    %>

    <div class="os-pagehead">
      <div class="lead">
        <span class="os-kicker"><span class="star">✦</span>Recorded Ratings Round-Up<span class="star">✦</span></span>
        <h1>The Ratings DB</h1>
        <p class="blurb">
          Everything Abbabox has officially judged on stream — movies, snacks, life choices —
          always out of four. Consult from chat with <code>!rating&nbsp;thing</code>.
        </p>
      </div>
      <div class="aside">
        <div class="os-stat big">
          <span class="label">Total Ratings</span>
          <span class="os-tote"><%= items.length %></span>
        </div>
        <div class="os-stat big">
          <span class="label">Average Verdict</span>
          <span class="os-tote"><%= avg %></span>
          <span class="sub">of four</span>
        </div>
      </div>
    </div>

    <div class="os-toolbar">
      <label class="os-search">
        <span class="ico">⌕</span>
        <input type="search" data-ledger-search="ratings" placeholder="Search the verdicts… (try 'sushi')">
      </label>
      <button class="os-chip" type="button" data-ledger-sort="ratings" data-key="ts" data-dir="desc" data-type="num">Recent</button>
      <button class="os-chip" type="button" data-ledger-sort="ratings" data-key="rating" data-dir="desc" data-type="num">Highest</button>
      <button class="os-chip" type="button" data-ledger-sort="ratings" data-key="rating" data-dir="asc" data-type="num">Lowest</button>
    </div>

    <div class="os-content">
      <div class="os-ledger" data-ledger="ratings" data-page-size="25" style="--cols: 1fr 210px 180px;">
        <div class="os-lhead">
          <span>Subject</span><span>Verdict</span><span class="os-right">Date Judged</span>
        </div>
        <% items.forEach(function (r) { %>
        <div class="os-lrow"
             data-search="<%= String(r.item).toLowerCase() %>"
             data-ts="<%= r.ts %>"
             data-rating="<%= r.rating %>">
          <span class="entry strong"><%= r.item %></span>
          <span style="display: inline-flex; align-items: center; gap: 14px;">
            <span class="os-rating">
              <% for (let i = 0; i < 4; i++) {
                   const fill = Math.min(1, Math.max(0, r.rating - i)); %>
              <i class="<%= fill >= 1 ? 'full' : (fill > 0 ? 'half' : '') %>"></i>
              <% } %>
            </span>
            <span class="os-rating-val"><%= r.rating %></span>
          </span>
          <span class="mono os-right"><%= r.dateLabel %></span>
        </div>
        <% }); %>
      </div>
    </div>

    <div class="os-pages" data-ledger-pages="ratings"></div>

  </main>
  <%- include('partials/site-footer') %>
</body>
</html>
