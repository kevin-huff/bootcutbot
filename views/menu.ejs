<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/site-head', {
    title: 'Bootcut — The Command Menu',
    description: "Find commands for Abbabox's twitch stream chatbot lovingly named Abbadabbabot"
  }) %>
</head>
<body class="os-body">
  <%- include('partials/site-nav', { active: 'menu' }) %>
  <main class="os-main">
    <%
      const groups = [
        {
          title: 'Bootcut · The Queue', color: 'var(--gilt-bright)',
          cmds: [
            { cmd: '!join', desc: 'Claim your place in line. Careful during the initial rush — you may get bumped.' },
            { cmd: '!leave', desc: "Abandon the queue so you won't get picked. Rejoin later and you forfeit your place." },
            { cmd: '!position', desc: 'Consult the Oracle on your current position in the queue.' },
            { cmd: '!list', desc: 'A link to the live queue page.' },
            { cmd: '!auto_splot', desc: 'Your turn only — fate picks a random splot from the archive for you.' },
            { cmd: '!splots_db', desc: 'A link to every historical splot.' },
            { cmd: '!ba_count', desc: 'Personal breakaway mode only — how many breakaways you hold. A 100-bit cheer buys 5 more.' },
          ],
        },
        {
          title: 'Fun · Abbadabbabot', color: 'var(--crimson-bright)',
          cmds: [
            { cmd: '!deeznutz', desc: 'Abbadabbabot attempts a deez nutz joke.' },
            { cmd: '!dn_count', desc: 'The count of deez nutz jokes since 7/21/22.' },
            { cmd: '!justice', desc: "A reminder of Abbabox's crimes. Abbadabbabot tries to defend him." },
            { cmd: '!cherish', desc: 'Abbadabbabot tells you how Abbabox cherishes your butt.' },
            { cmd: '!wakeup', desc: 'Urge Abba to wake from his nap and start stream.' },
            { cmd: '!rise', desc: "Find out about Abbadabbabot's reincarnation." },
            { cmd: '!exercise', desc: 'Abbadabbabot tries to convince Abbabox to exercise.' },
            { cmd: '!chesthair', desc: "Something nice about Abbabox's chest hair." },
            { cmd: '!backhair', desc: "Something nice about Abbabox's back hair." },
            { cmd: '!butthair', desc: "Something nice about Abbabox's butt hair." },
            { cmd: '!joeydoodah', desc: 'A story about joeydoodah.' },
          ],
        },
        {
          title: 'Info · The Records', color: 'var(--jade)',
          cmds: [
            { cmd: '!rating thing', desc: 'Has Abba judged it? Learn the verdict — movies, items, events.' },
            { cmd: '!ratings', desc: 'A link to the full Ratings DB.' },
            { cmd: '!log_roll', desc: 'Log a roll — help prove how buttered the dice are.' },
            { cmd: '!ded_count', desc: 'Death and crash count, when tracking is on.' },
            { cmd: '!timeleft', desc: 'Endurance streams only — how long remains.' },
          ],
        },
        {
          title: 'Media Share', color: 'var(--violet)',
          cmds: [
            { cmd: '!check_abbacoin', desc: 'Your current abbacoin balance.' },
          ],
        },
      ];
    %>

    <div class="os-pagehead">
      <div class="lead">
        <span class="os-kicker"><span class="star">✦</span>Abbadabbabot<span class="star">✦</span></span>
        <h1>The Command Menu</h1>
        <p class="blurb">
          Every incantation the bot answers to, gathered in one place. Click a command to copy it,
          then speak it into Twitch chat.
          <% if (first_turn_first) { %>
          <em style="color: var(--parchment-faint);">First-turns-first is on: those who have not yet
          had a turn are seated before repeat players.</em>
          <% } %>
        </p>
      </div>
      <div style="display: flex; flex-direction: column; gap: 12px; align-items: flex-end;">
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <% if (queue_open) { %>
          <span class="os-badge jade"><span class="os-led sm is-blink" style="--c: var(--jade)"></span>Queue Open</span>
          <% } else { %>
          <span class="os-badge is-off"><span class="os-led sm is-off"></span>Queue Closed</span>
          <% } %>
          <% if (first_turn_first) { %>
          <span class="os-badge"><span class="os-led sm is-blink"></span>Firsts First</span>
          <% } %>
        </div>
        <span class="mono" style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.22em; color: var(--parchment-faint); text-transform: uppercase;">
          Current player · <%= current_turn %>
        </span>
      </div>
    </div>

    <div class="os-menu-cols">
      <% groups.forEach(function (g) { %>
      <div class="os-menu-group">
        <div class="ghead">
          <span class="os-led xs is-blink" style="--c: <%= g.color %>"></span>
          <span class="t"><%= g.title %></span>
          <span class="n"><%= g.cmds.length %> CMDS</span>
        </div>
        <div class="glist">
          <% g.cmds.forEach(function (c) { %>
          <div class="os-cmd">
            <span class="os-cmd-code" title="Click to copy" data-copy="<%= c.cmd %>"><%= c.cmd %><span class="copy-ico">⧉</span></span>
            <span class="desc"><%= c.desc %></span>
          </div>
          <% }); %>
        </div>
      </div>
      <% }); %>
    </div>

  </main>
  <%- include('partials/site-footer') %>
</body>
</html>
