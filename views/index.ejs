<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/site-head', {
    title: 'Bootcut — The Queue',
    description: 'The Bootcut Queue is a unique platform for viewing your place in the Bootcut Queue, check the current player, and view previous turns. Support Abbabox and join the fun! Bootcut is a cutting edge interactive game show on Twitch, hosted by the one and only abbabox.'
  }) %>
  <script src="/socket.io/socket.io.js"></script>
</head>
<body class="os-body">
  <%- include('partials/site-nav', { active: 'queue' }) %>
  <main class="os-main">

    <!-- Proscenium hero -->
    <section class="os-hero">
      <%- include('partials/lamps', { n: 34 }) %>
      <span class="os-arch tl"></span><span class="os-arch tr"></span>
      <span class="os-arch bl"></span><span class="os-arch br"></span>
      <div class="center" style="margin-bottom: 12px;">
        <span class="os-kicker" style="font-size: 11px;"><span class="star">✦</span>Abbabox presents<span class="star">✦</span></span>
      </div>
      <div class="os-wordmark">BOOT<span class="cut">CUT</span></div>
      <div class="center" style="margin-top: 14px;">
        <span class="os-hand" style="font-size: 14px;">— An interactive game of fate —</span>
      </div>
      <p class="lead">
        The queue writes the dares. The dice seal the fate. Bootcut is Abbabox's live
        board game on Twitch, where chat makes the content and the streamer does the thing.
      </p>
      <div class="ctas">
        <a class="os-pill lg hot" href="https://twitch.tv/abbabox" target="_blank" rel="noopener"><span class="ico">▶</span>Watch Live</a>
        <span class="os-pill lg ghost">Type !join in chat</span>
      </div>
    </section>

    <!-- Status badges -->
    <div class="os-status-row">
      <% if (queue_open) { %>
      <span class="os-badge jade"><span class="os-led sm is-blink" style="--c: var(--jade)"></span>Queue Open</span>
      <% } else { %>
      <span class="os-badge is-off"><span class="os-led sm is-off"></span>Queue Closed</span>
      <% } %>
      <% if (first_turn_first) { %>
      <span class="os-badge"><span class="os-led sm is-blink"></span>First Turns First</span>
      <% } %>
      <span class="os-badge dim"><span class="os-led sm" style="--c: var(--parchment-dim)"></span>Turn № <%= turn_count - 1 %></span>
      <span class="os-badge crimson"><span class="os-led sm is-blink" style="--c: var(--crimson-bright)"></span>Next Pick · <%= turn_count % magic_number ? 'Random' : 'Next' %></span>
    </div>

    <!-- Hot seat -->
    <section class="os-hotseat">
      <%- include('partials/lamps', { n: 30 }) %>
      <div class="inner">
        <div class="who">
          <span class="k">
            <span class="os-led is-blink"></span>
            <span class="os-kicker">Now in the hot seat</span>
          </span>
          <span class="name" id="current_player"><%= current_turn %></span>
          <span class="meta">Turn № <%= turn_count - 1 %> · Queue <%= queue_open ? 'Open' : 'Closed' %></span>
        </div>
        <div class="totes">
          <div class="cell">
            <span class="k">In Queue</span>
            <span class="os-tote xl"><%= String(queue.length).padStart(2, '0') %></span>
          </div>
          <div class="cell">
            <span class="k">Next Pick</span>
            <span class="os-tote xl crimson"><%= turn_count % magic_number ? 'RND' : 'NXT' %></span>
          </div>
        </div>
      </div>
    </section>

    <!-- Queue + Chronicle -->
    <div class="os-home-tables">
      <div>
        <div class="os-section-bar"><span class="t">The Queue · <%= queue.length %> in line</span></div>
        <div class="os-ledger hl-first" style="--cols: 48px 1fr 120px;">
          <div class="os-lhead">
            <span>№</span><span>Contestant</span><span class="os-right">Turns Called</span>
          </div>
          <% queue.forEach(function (q, index) { %>
          <div class="os-lrow">
            <span class="num"><%= String(index + 1).padStart(2, '0') %></span>
            <span class="entry strong"><a href="/u/<%= encodeURIComponent(String(q['display-name']).toLowerCase()) %>"><%= q['display-name'] %></a><% if (!q['turn_count']) { %> <span class="os-tag">First Timer</span><% } %></span>
            <span class="mono os-right"><%= q['turn_count'] %></span>
          </div>
          <% }); %>
          <% if (!queue.length) { %>
          <div class="os-empty">The queue stands empty. Type !join in chat to claim your place.</div>
          <% } %>
        </div>
      </div>
      <div>
        <div class="os-section-bar"><span class="t">The Chronicle · previous turns</span></div>
        <div class="os-ledger" style="--cols: 48px 1fr 90px;">
          <div class="os-lhead">
            <span>№</span><span>Contestant</span><span class="os-right">Turn</span>
          </div>
          <% turns.reverse(); %>
          <% turns.forEach(function (turn, index) { %>
          <div class="os-lrow">
            <span class="num"><%= String(turns.length - index).padStart(2, '0') %></span>
            <span class="entry strong"><a href="/u/<%= encodeURIComponent(String(turn['display-name']).toLowerCase()) %>"><%= turn['display-name'] %></a></span>
            <span class="mono os-right">№ <%= turn['turn_count'] + 1 %></span>
          </div>
          <% }); %>
          <% if (!turns.length) { %>
          <div class="os-empty">No turns recorded yet this stream.</div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Breakaway codex -->
    <section style="margin-top: 44px;">
      <div class="os-section-bar"><span class="t">The Breakaway Codex · escape your fate</span></div>
      <p class="lead" style="text-align: left; margin: 0 0 18px; max-width: none;">
        Land on a splot you'd rather not face? Spend a <strong>breakaway</strong> and roll the d6 —
        erase it, get forced into it, or re-roll your fate.
        <% if (user_ba_mode) { %>
        Personal mode is on: every chatter holds their own stash and starts with
        <strong><%= ba.starting_bas %></strong>. Check yours with <code>!ba_count</code> or on your contestant page.
        <% } else { %>
        Right now breakaways run from the shared pool; when Personal Breakaway Mode is on,
        every chatter holds their own stash and starts with <strong><%= ba.starting_bas %></strong>.
        <% } %>
      </p>
      <div class="os-home-tables">
        <div>
          <div class="os-ledger" style="--cols: 150px 1fr 130px;">
            <div class="os-lhead">
              <span>Way</span><span>How</span><span class="os-right">Price</span>
            </div>
            <div class="os-lrow">
              <span class="entry strong">Bits</span>
              <span class="entry">Cheer exactly <%= ba.bits_pack_cost %> bits for a pack of <%= ba.bits_pack_size %></span>
              <span class="mono os-right"><%= ba.bits_pack_cost %> bits</span>
            </div>
            <%
              const cpr = ba.cp_rewards;
              const cpResting = !cp.any_live ? ' — resting between streams' : '';
              const rt = (r) => String(r.title || '').replace(/\{n\}/g, r.amount);
            %>
            <div class="os-lrow">
              <span class="entry strong">Channel Points</span>
              <span class="entry">Redeem “<%= rt(cpr.self_pack) %>” (<%= cpr.self_pack.amount %>) or “<%= rt(cpr.self_single) %>” (1)<%= cpResting %></span>
              <span class="mono os-right"><%= cpr.self_pack.cost %> / <%= cpr.self_single.cost %> pts</span>
            </div>
            <div class="os-lrow">
              <span class="entry strong">The Board</span>
              <span class="entry">Certain splots award breakaways to whoever survives them</span>
              <span class="mono os-right">earned</span>
            </div>
            <div class="os-lrow">
              <span class="entry strong">Gifts</span>
              <span class="entry">Any chatter can share their stash — mercy is legal tender</span>
              <span class="mono os-right">gifted</span>
            </div>
            <div class="os-lrow">
              <span class="entry strong">For Abbabox</span>
              <span class="entry">Bless the house — redeem channel points to stock Abbabox's own stash<%= cpResting %></span>
              <span class="mono os-right"><%= cpr.abba_pack.cost %> / <%= cpr.abba_single.cost %> pts</span>
            </div>
          </div>
        </div>
        <div>
          <div class="os-ledger" style="--cols: 190px 1fr;">
            <div class="os-lhead">
              <span>Command</span><span>What it does</span>
            </div>
            <div class="os-lrow">
              <span class="mono">!ba_count</span>
              <span class="entry">How many breakaways you hold</span>
            </div>
            <div class="os-lrow">
              <span class="mono">!gift_ba user 2</span>
              <span class="entry">Gift 2 of yours to another chatter</span>
            </div>
            <div class="os-lrow">
              <span class="mono">!gift_ba</span>
              <span class="entry">Gift 1 to whoever's in the hot seat — save them from their fate</span>
            </div>
          </div>
          <p style="font-family: var(--font-body); font-size: 14px; color: var(--parchment-faint); font-style: italic; margin: 12px 2px 0;">
            The whole economy — circulation, hoarders, and every recent movement — is on public record in
            <a href="/economy" style="color: var(--gilt);">The Breakaway Economy</a>.
          </p>
        </div>
      </div>
    </section>

  </main>
  <%- include('partials/site-footer') %>
  <script>
    (function () {
      var socket = io();
      socket.on('new_turn', function (msg) {
        var el = document.getElementById('current_player');
        if (el) el.textContent = msg || '';
      });
    })();
  </script>
</body>
</html>
